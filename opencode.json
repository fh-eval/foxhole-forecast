{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.6-luna": {
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low"
            }
          }
        }
      }
    }
  },
  "agent": {
    "failure-triage": {
      "description": "Read-only diagnosis of an expected model missing from a forecast cohort",
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.6-luna",
      "prompt": "{file:./.opencode/prompts/failure-triage.txt}",
      "variant": "high",
      "steps": 10,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "skill": "deny",
        "question": "deny"
      }
    }
  }
}
