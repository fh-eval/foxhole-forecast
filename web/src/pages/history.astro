---
import "../styles/global.css";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Newspaper-style archive of Foxhole Forecast model briefings and summaries." />
    <title>Summary Archive · Foxhole Forecast</title>
  </head>
  <body>
    <header class="method-masthead archive-masthead">
      <div class="masthead__eyebrow">THE CLIPPINGS FILE · WHAT THE MODELS THOUGHT, WHEN THEY THOUGHT IT</div>
      <div class="method-hero page-width">
        <div>
          <p class="kicker">Summary archive</p>
          <h1>What they said<br /><span>at the time</span></h1>
          <p class="sublede">Before every round, each model writes a short dispatch about the state of the war. These are those dispatches, pinned to their moment — read them like dated field notes, then check the calls they accompanied in round history.</p>
        </div>
        <a class="method-back" href={basePath}>← Return to dashboard</a>
      </div>
    </header>

    <nav class="section-nav" aria-label="Summary archive navigation">
      <div class="page-width">
        <a href={basePath}>Live dashboard</a>
        <a href={`${basePath}predictions/`}>Round history</a>
        <a href={`${basePath}#scoreboard`}>The scoreboard</a>
      </div>
    </nav>

    <main class="archive-page page-width">
      <section class="section-block archive-section">
        <div class="section-heading section-heading--controls">
          <div><p class="kicker">Newest first</p><h2>Briefing clippings</h2></div>
          <div class="prediction-controls">
            <label class="select-label">War <select id="archive-war"><option value="all">All wars</option></select></label>
            <label class="select-label">Model <select id="archive-model"><option value="all">All models</option></select></label>
          </div>
        </div>
        <p class="plain-note"><strong>Why keep these?</strong> A briefing shows what a model believed and how unsure it was at a frozen moment. Good context — but the scored evidence lives in the dated calls, not in the prose.</p>
        <p class="prediction-browser__summary" id="archive-summary">Loading summary archive…</p>
        <div id="summary-archive"></div>
      </section>
    </main>

    <footer><div class="page-width"><strong>FOXHOLE FORECAST</strong><span id="generated-at">No dataset generated yet</span></div></footer>

    <script>
      // @ts-nocheck
      const element = (tag, className, text) => { const value = document.createElement(tag); if (className) value.className = className; if (text !== undefined) value.textContent = String(text); return value; };
      const number = (value) => new Intl.NumberFormat().format(Number(value) || 0);
      const formatDate = (value) => value ? new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(new Date(value)) + " UTC" : "—";
      const regionNames = {
        AllodsBightHex: "Allod's Bight",
        CallahansPassageHex: "Callahan's Passage",
        CallumsCapeHex: "Callum's Cape",
        FishermansRowHex: "Fisherman's Row",
        KingsCageHex: "King's Cage",
        MorgensCrossingHex: "Morgen's Crossing",
        ReaversPassHex: "Reaver's Pass",
      };
      const regionLabel = (value) => regionNames[value] || String(value || "Unknown region").replace(/Hex$/, "").replace(/([a-z])([A-Z])/g, "$1 $2");
      let dashboard = null; let warFilter = "all"; let modelFilter = "all";

      function briefingSummary(text) {
        const content = String(text || "No summary was retained for this cutoff.");
        const wrapper = element("div", "briefing-summary");
        const copy = element("p", "clipping__summary briefing-summary__copy", content);
        wrapper.append(copy);
        if (content.length <= 420) return wrapper;
        copy.classList.add("briefing-summary__copy--collapsed");
        const toggle = element("button", "briefing-summary__toggle", "… Read full briefing");
        toggle.type = "button";
        toggle.setAttribute("aria-expanded", "false");
        toggle.addEventListener("click", () => {
          const expanded = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!expanded));
          copy.classList.toggle("briefing-summary__copy--collapsed", expanded);
          toggle.textContent = expanded ? "… Read full briefing" : "Show less";
        });
        wrapper.append(toggle);
        return wrapper;
      }

      function entries() {
        return (dashboard.models || []).flatMap((model) => (model.history || [])
          .filter((entry) => typeof entry.war_summary === "string" && entry.war_summary.trim())
          .map((entry) => ({ ...entry, model_label: model.label || model.series_id, series_id: model.series_id })));
      }

      function renderArchive() {
        const root = document.querySelector("#summary-archive"); const summary = document.querySelector("#archive-summary"); root.replaceChildren();
        const filtered = entries().filter((entry) => (warFilter === "all" || String(entry.war_id) === warFilter) && (modelFilter === "all" || entry.series_id === modelFilter));
        const wars = new Map();
        filtered.forEach((entry) => { const key = String(entry.war_id || entry.war_number || "unknown"); if (!wars.has(key)) wars.set(key, { warId: entry.war_id, warNumber: entry.war_number, entries: [] }); wars.get(key).entries.push(entry); });
        const groups = [...wars.values()].sort((a, b) => Number(b.warNumber || 0) - Number(a.warNumber || 0));
        groups.forEach((group) => group.entries.sort((a, b) => new Date(b.cutoff || 0) - new Date(a.cutoff || 0)));
        summary.textContent = `${number(filtered.length)} summary clipping${filtered.length === 1 ? "" : "s"} · ${number(groups.length)} war${groups.length === 1 ? "" : "s"}`;
        if (!filtered.length) { root.append(element("p", "empty-state", "No model summaries match these filters.")); return; }
        groups.forEach((group) => {
          const section = element("section", "war-archive");
          const heading = element("div", "war-archive__heading"); heading.append(element("p", "kicker", "Filed by war"), element("h3", "", `War ${group.warNumber || "—"}`), element("span", "", `${group.entries.length} clipping${group.entries.length === 1 ? "" : "s"}`)); section.append(heading);
          const grid = element("div", "clipping-grid");
          group.entries.forEach((entry) => {
            const clipping = element("article", "clipping");
            const mast = element("div", "clipping__masthead"); mast.append(element("strong", "", entry.model_label), element("span", "", formatDate(entry.cutoff))); clipping.append(mast);
            const status = entry.settlement_status || entry.status || "open";
            clipping.append(element("p", "clipping__kicker", `${entry.forecast_count || 0} calls · ${status}`));
            clipping.append(briefingSummary(entry.war_summary));
            const meta = element("div", "clipping__meta");
            meta.append(element("span", "", `${(entry.selected_regions || []).length} regions selected`));
            if (entry.cost_usd != null) meta.append(element("span", "", `$${Number(entry.cost_usd).toFixed(3)} model cost`));
            clipping.append(meta);
            if (entry.selected_regions?.length) clipping.append(element("p", "clipping__regions", entry.selected_regions.map(regionLabel).join(" · ")));
            grid.append(clipping);
          });
          section.append(grid); root.append(section);
        });
      }

      async function boot() {
        try {
          const base = import.meta.env.BASE_URL.replace(/\/?$/, "/"); const response = await fetch(`${base}data/dashboard.json`, { cache: "no-store" }); if (!response.ok) throw new Error(`HTTP ${response.status}`); dashboard = await response.json();
          const warSelect = document.querySelector("#archive-war"); const modelSelect = document.querySelector("#archive-model"); const wars = new Map(); const models = new Map();
          entries().forEach((entry) => { wars.set(String(entry.war_id), `War ${entry.war_number || "—"}`); models.set(entry.series_id, entry.model_label); });
          [...wars.entries()].sort((a, b) => Number(b[1].replace(/\D/g, "")) - Number(a[1].replace(/\D/g, ""))).forEach(([value, label]) => { const option = element("option", "", label); option.value = value; warSelect.append(option); });
          [...models.entries()].sort((a, b) => a[1].localeCompare(b[1])).forEach(([value, label]) => { const option = element("option", "", label); option.value = value; modelSelect.append(option); });
          warSelect.addEventListener("change", () => { warFilter = warSelect.value; renderArchive(); }); modelSelect.addEventListener("change", () => { modelFilter = modelSelect.value; renderArchive(); });
          document.querySelector("#generated-at").textContent = `Generated ${formatDate(dashboard.generated_at)}`; renderArchive();
        } catch (error) { document.querySelector("#archive-summary").textContent = `Summary archive unavailable: ${error.message}`; }
      }
      boot();
    </script>
  </body>
</html>
