---
import "../styles/global.css";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="History of Foxhole Forecast prediction rounds, grouped by war and shared three-hour round." />
    <title>Round History · Foxhole Forecast</title>
  </head>
  <body>
    <header class="method-masthead">
      <div class="masthead__eyebrow">EVERY ROUND ON RECORD · SAME CUTOFF FOR EVERY MODEL</div>
      <div class="method-hero prediction-hero page-width">
        <div>
          <p class="kicker">Round history</p>
          <h1>Every call,<br /><span>on the record</span></h1>
          <p class="sublede">The archive is organised the way the experiment runs: by war, then by shared three-hour round. Open any round to compare each model’s briefing, ranked calls, evidence, and how they settled.</p>
        </div>
        <a class="method-back" href={basePath}>← Return to dashboard</a>
      </div>
    </header>

    <nav class="section-nav" aria-label="Round history navigation">
      <div class="page-width">
        <a href={basePath}>Live dashboard</a>
        <a href={`${basePath}history/`}>Summary archive</a>
        <a href={`${basePath}#scoreboard`}>The scoreboard</a>
      </div>
    </nav>

    <main class="prediction-page page-width">
      <section class="section-block prediction-browser-section round-history-section">
        <div class="section-heading section-heading--controls">
          <div><p class="kicker">Newest first</p><h2>Shared prediction rounds</h2></div>
          <div class="prediction-controls">
            <label class="select-label">War <select id="round-war"><option value="all">All wars</option></select></label>
            <label class="select-label">Model <select id="round-model"><option value="all">All models</option></select></label>
          </div>
        </div>
        <p class="plain-note"><strong>Why group by round?</strong> Every model in a round worked from the same frozen moment. Comparing them inside that window is fair; comparing random individual calls across days is not. <span class="format-note">Older experiments remain in the archive, marked <em>Legacy format</em>; compare those with care because their prompts and scoring rules were different.</span></p>
        <p class="prediction-browser__summary" id="round-summary">Loading round history…</p>
        <div id="round-history" class="round-history-list"></div>
      </section>
    </main>

    <footer><div class="page-width"><strong>FOXHOLE FORECAST</strong><span id="generated-at">No dataset generated yet</span></div></footer>

    <script>
      // @ts-nocheck
      const element = (tag, className, text) => { const value = document.createElement(tag); if (className) value.className = className; if (text !== undefined) value.textContent = String(text); return value; };
      const percentage = (value) => value == null || !Number.isFinite(Number(value)) ? "—" : `${(100 * Number(value)).toFixed(1)}%`;
      const number = (value) => new Intl.NumberFormat().format(Number(value) || 0);
      const eventLabel = (value) => String(value || "").replaceAll("_", " ").toLowerCase().replace(/\b\w/g, (letter) => letter.toUpperCase());
      const teamLabel = (value) => value === "NONE" ? "Neutral / destroyed" : eventLabel(value);
      const regionNames = {
        AllodsBightHex: "Allod's Bight",
        CallahansPassageHex: "Callahan's Passage",
        CallumsCapeHex: "Callum's Cape",
        FishermansRowHex: "Fisherman's Row",
        KingsCageHex: "King's Cage",
        MorgensCrossingHex: "Morgen's Crossing",
        ReaversPassHex: "Reaver's Pass",
      };
      const regionLabel = (value) => regionNames[value] || String(value || "Unknown region").replace(/Hex$/, "").replace(/([a-z])([A-Z])/g, "$1 $2");
      const formatDate = (value) => value ? new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(new Date(value)) + " UTC" : "—";
      const modelFormat = (record) => {
        const series = String(record?.series_id || "");
        if (record?.protocol === "event_outcome_v5_crps" || series.includes("-event-v4")) return "";
        if (record?.protocol === "timed_transition_v3" || series.includes("-timed-v3")) return " · Legacy timed format";
        if (series.includes("war-overview-v2")) return " · Legacy war overview";
        return " · Legacy format";
      };
      const modelLabel = (record) => `${record?.model_label || record?.label || record?.series_id || "Unknown model"}${modelFormat(record)}`;
      const predictionTime = (value) => value ? new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "UTC" }).format(new Date(value)) + " UTC" : "an unknown time";
      const duration = (minutes) => minutes == null ? "—" : Number(minutes) < 60 ? `${Math.round(Number(minutes))}m` : `${(Number(minutes) / 60).toFixed(1)}h`;
      const crps = (minutes) => minutes == null || !Number.isFinite(Number(minutes)) ? "—" : `${Number(minutes).toFixed(2)}m`;
      const evidenceValue = (item) => {
        if (item.value == null) return "value unavailable";
        if (String(item.metric_id).includes("ratio_")) return `${Number(item.value).toFixed(2)}×`;
        const formatted = number(item.value);
        return String(item.metric_id).includes(".delta_") && Number(item.value) > 0 ? `+${formatted}` : formatted;
      };
      const evidenceChip = (item) => { const chip = element("span", "evidence-chip", `${item.label || item.metric_id}: ${evidenceValue(item)} · relevance ${item.relevance}/10`); if (item.observed_at) chip.title = `Metric observed ${formatDate(item.observed_at)}`; return chip; };
      const factionName = (team) => element("span", `faction-name faction-name--${String(team || "none").toLowerCase()}`, teamLabel(team));
      const baseIdentity = (bet) => element("strong", `base-identity base-identity--${String(bet.current_team || "none").toLowerCase()}`, `${bet.base_type || "Strategic Base"} ${bet.base_name || "Unknown base"}`);

      function briefingSummary(text) {
        const content = String(text || "No briefing was retained for this round.");
        const wrapper = element("div", "briefing-summary");
        const copy = element("p", "briefing__copy briefing-summary__copy", content);
        wrapper.append(copy);
        if (content.length <= 420) return wrapper;
        copy.classList.add("briefing-summary__copy--collapsed");
        const toggle = element("button", "briefing-summary__toggle", "… Read full briefing");
        toggle.type = "button";
        toggle.setAttribute("aria-expanded", "false");
        toggle.addEventListener("click", () => {
          const expanded = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!expanded));
          copy.classList.toggle("briefing-summary__copy--collapsed", expanded);
          toggle.textContent = expanded ? "… Read full briefing" : "Show less";
        });
        wrapper.append(toggle);
        return wrapper;
      }

      function predictionHeadline(bet) {
        const line = element("p", "prediction-headline");
        const outcome = bet.predicted_outcome || bet.outcome;
        const spread = bet.sigma_minutes == null ? "" : ` · timing spread ${duration(bet.sigma_minutes)}${bet.sigma_source === "inferred_from_confidence" ? " (inferred)" : ""}`;
        line.append(element("strong", "prediction-headline__confidence", `${percentage(bet.confidence)} chance`), document.createTextNode(`${spread}: `), baseIdentity(bet));
        if (outcome === "DESTROYED" || outcome === "SELF_CAPTURE") line.append(document.createTextNode(outcome === "SELF_CAPTURE" ? " will be destroyed (self-capture protocol) at " : " will be destroyed at "));
        else {
          line.append(document.createTextNode(" will be captured by "));
          const faction = outcome === "CAPTURED_BY_WARDENS" ? "WARDENS" : outcome === "CAPTURED_BY_COLONIALS" ? "COLONIALS" : bet.current_team === "WARDENS" ? "COLONIALS" : bet.current_team === "COLONIALS" ? "WARDENS" : null;
          if (faction) line.append(factionName(faction)); else line.append(factionName("WARDENS"), document.createTextNode(" or "), factionName("COLONIALS"));
          line.append(document.createTextNode(" at "));
        }
        line.append(element("time", "prediction-headline__time", predictionTime(bet.eta_utc)), document.createTextNode("."));
        return line;
      }

      function supportingEvidence(items) {
        const wrapper = element("div", "supporting-evidence");
        wrapper.append(element("small", "supporting-evidence__label", "Model-cited evidence · relevance is the model's own 1–10 rating"));
        const evidence = element("div", "evidence-list");
        (items || []).forEach((item) => evidence.append(evidenceChip(item)));
        if (!items?.length) evidence.append(element("span", "evidence-empty", "No supporting evidence retained."));
        wrapper.append(evidence); return wrapper;
      }

      function predictionStatus(bet) {
        if (bet.status === "censored" && bet.settlement_reason === "ambiguous_transition_interval") return "Not scored · transition time ambiguous";
        if (bet.status === "censored") return "Not scored · missing observations";
        if (bet.crps_minutes != null && bet.settlement_reason === "no_transition_by_deadline") return "Scored · no qualifying transition by deadline";
        if (bet.crps_minutes != null && bet.settlement_reason === "observed_transition") {
          const observation = Number(bet.state_credit) === 1 ? "named outcome observed" : Number(bet.state_credit) > 0 ? "related outcome observed" : "different outcome observed";
          return `Scored · ${observation}${bet.eta_error_minutes != null ? ` · ${bet.eta_error_minutes}m from ETA` : ""}`;
        }
        if (bet.crps_minutes != null) return "Scored";
        return eventLabel(bet.status || "open");
      }

      function predictionQuality(bet) {
        if (bet.crps_minutes == null) return null;
        const state = Number(bet.state_credit);
        const timing = Number(bet.timing_credit);
        const error = bet.eta_error_minutes != null
          ? Number(bet.eta_error_minutes)
          : bet.eta_error_max_minutes != null
            ? Number(bet.eta_error_max_minutes)
            : null;
        const sigma = Number(bet.sigma_minutes);
        const insideSpread = Number.isFinite(error) && Number.isFinite(sigma) && error <= sigma;
        if (state === 0 || state === 1 && timing === 0 || bet.status === "miss" && state <= 0) return "miss";
        if (state === 1 && insideSpread) return "hit";
        return "partial";
      }

      function roundStatusBadges(predictions, droppedCount = 0) {
        const bets = predictions || [];
        const total = bets.length;
        const scored = bets.filter((bet) => bet.crps_minutes != null).length;
        const resolved = bets.filter((bet) => bet.status && bet.status !== "open").length;
        const hasCensored = bets.some((bet) => bet.status === "censored");
        const scoredClass = scored === total ? "complete" : scored ? "partial" : "censored";
        const resolvedClass = resolved < total ? "open" : hasCensored ? "censored" : "complete";
        const badges = element("span", "round-statuses");
        badges.append(
          element("span", `status status--${scoredClass}`, `${scored}/${total} scored`),
          element("span", `status status--${resolvedClass}`, `${resolved}/${total} resolved`),
        );
        if (droppedCount) badges.append(element("span", "status status--partial", `${droppedCount} dropped`));
        return badges;
      }

      function predictionResult(bet) {
        const result = element("div", "prediction-result");
        const quality = predictionQuality(bet);
        const statusClass = quality || bet.status || "open";
        const status = element("small", `status status--${statusClass}`, predictionStatus(bet));
        if (quality) status.title = quality === "hit"
          ? "Correct: the named outcome was observed inside the model's timing spread."
          : quality === "partial"
            ? "Error: the call received partial credit or landed outside the model's timing spread."
            : "Bad call: the named outcome or timing received no credit.";
        result.append(status);
        if (bet.crps_minutes != null) {
          const badge = element("span", "prediction-score prediction-score--scored");
          badge.title = status.title || "Forecast error measured by CRPS.";
          badge.append(
            element("span", "prediction-score__label", "Whole forecast error · CRPS"),
            element("strong", `prediction-score__value prediction-score--${quality || "partial"}`, crps(bet.crps_minutes)),
          );
          result.append(badge);
        }
        return result;
      }

      function renderBet(bet) {
        const row = element("article", "round-bet");
        const meta = element("div", "round-bet__meta");
        meta.append(element("span", "", `#${bet.rank ?? "—"} · ${bet.tranche === "IMMEDIATE" ? "Next 6 hours" : bet.tranche === "EXTENDED" ? "Next day" : eventLabel(bet.tranche)} · ${regionLabel(bet.map_name)}`), predictionResult(bet));
        row.append(meta, predictionHeadline(bet), supportingEvidence(bet.evidence)); return row;
      }

      function renderStrategicAdvice(advice) {
        if (!advice || typeof advice !== "object") return null;
        const items = Object.entries(advice).filter(([, value]) => value && (value.base_name || value.base_id));
        if (!items.length) return null;
        const section = element("section", "strategic-advice");
        section.append(element("small", "strategic-advice__label", "Strategic adviser note · separate from scored predictions"));
        const list = element("div", "strategic-advice__grid");
        items.forEach(([key, item]) => {
          const card = element("article", "strategic-advice__item");
          card.append(element("strong", "", eventLabel(key).replace("Colonial ", "Colonial: ").replace("Warden ", "Warden: ")), element("h4", "", `${item.base_type || "Strategic Base"} ${item.base_name || item.base_id}`), element("p", "", item.reason || "No reason retained."));
          if (item.map_name || item.current_team) card.append(element("small", "", `${regionLabel(item.map_name)} · currently ${teamLabel(item.current_team)}`));
          if (Array.isArray(item.evidence) && item.evidence.length) { const evidence = element("div", "evidence-list"); item.evidence.forEach((entry) => evidence.append(evidenceChip(entry))); card.append(evidence); }
          list.append(card);
        });
        section.append(list); return section;
      }

      let dashboard = null; let warFilter = "all"; let modelFilter = "all";
      const usableRound = (round) => Array.isArray(round.predictions) && round.predictions.length > 0 && round.predictions.some((bet) => bet.base_name && bet.eta_utc);

      function roundGroups() {
        const groups = new Map();
        (dashboard.rounds || []).filter(usableRound).forEach((round) => {
          if (warFilter !== "all" && String(round.war_id) !== warFilter) return;
          const key = `${round.war_id || "unknown"}:${round.round_slot || round.cutoff}`;
          if (!groups.has(key)) groups.set(key, { key, warId: round.war_id, warNumber: round.war_number, slot: round.round_slot || round.cutoff, end: round.round_end, participants: [] });
          if (modelFilter === "all" || round.series_id === modelFilter) groups.get(key).participants.push(round);
        });
        const grouped = [...groups.values()].filter((group) => group.participants.length); const warSlots = new Map();
        grouped.forEach((group) => { const key = String(group.warId || "unknown"); if (!warSlots.has(key)) warSlots.set(key, []); warSlots.get(key).push(group.slot); });
        grouped.forEach((group) => { const slots = [...new Set(warSlots.get(String(group.warId || "unknown")))].sort((a, b) => new Date(a) - new Date(b)); group.roundNumber = slots.indexOf(group.slot) + 1; group.participants.sort((a, b) => modelLabel(a).localeCompare(modelLabel(b))); });
        return grouped.sort((a, b) => new Date(b.slot) - new Date(a.slot));
      }

      function renderHistory() {
        const list = document.querySelector("#round-history"); const summary = document.querySelector("#round-summary"); list.replaceChildren();
        const groups = roundGroups();
        summary.textContent = `${number(groups.length)} shared round${groups.length === 1 ? "" : "s"} · ${number(groups.reduce((count, group) => count + group.participants.length, 0))} model-round entries · newest first`;
        if (!groups.length) { list.append(element("p", "empty-state", "No prediction rounds match these filters.")); return; }
        const warGroups = new Map();
        groups.forEach((group) => { const key = String(group.warId || "unknown"); if (!warGroups.has(key)) warGroups.set(key, { warNumber: group.warNumber, rounds: [] }); warGroups.get(key).rounds.push(group); });
        [...warGroups.values()].forEach((war, warIndex) => {
          const warSection = element("section", "round-war-archive");
          const warHeading = element("div", "war-archive__heading"); warHeading.append(element("p", "kicker", "Filed by war"), element("h3", "", `War ${war.warNumber || "—"}`), element("span", "", `${war.rounds.length} shared rounds`)); warSection.append(warHeading);
          const warList = element("div", "round-history-list");
          war.rounds.forEach((group, index) => {
          const details = element("details", "archive-round"); if (warIndex === 0 && index === 0 && warFilter === "all" && modelFilter === "all") details.open = true;
          const summaryRow = element("summary", "archive-round__summary"); const groupPredictions = group.participants.flatMap((round) => round.predictions || []); const dropped = group.participants.reduce((count, round) => count + (round.dropped_predictions || []).length, 0); const end = group.end ? new Date(group.end) : new Date(new Date(group.slot).getTime() + 3 * 60 * 60 * 1000);
          const roundStatuses = roundStatusBadges(groupPredictions, dropped); roundStatuses.prepend(element("span", "round-statuses__models", `${group.participants.length} models`));
          summaryRow.append(element("strong", "", `War ${group.warNumber || "—"} · Round ${String(group.roundNumber).padStart(2, "0")}`), element("time", "", `${formatDate(group.slot)}–${formatDate(end)}`), roundStatuses);
          const body = element("div", "archive-round__body");
          group.participants.forEach((round) => {
            const participant = element("details", "round-model"); const participantSummary = element("summary", "round-model__summary");
            participantSummary.append(element("strong", "", modelLabel(round)), element("time", "", `Cutoff ${formatDate(round.cutoff)}`), roundStatusBadges(round.predictions, (round.dropped_predictions || []).length));
            const participantBody = element("div", "round-model__body"); participantBody.append(briefingSummary(round.war_summary), element("p", "region-list", (round.selected_regions || []).map(regionLabel).join(" · ") || "No selected regions"));
            const advice = renderStrategicAdvice(round.strategic_advice); if (advice) participantBody.append(advice);
            if (round.dropped_predictions?.length) {
              const warning = element("div", "method-note");
              warning.append(element("strong", "", `${round.dropped_predictions.length} model output error${round.dropped_predictions.length === 1 ? "" : "s"} excluded from this round’s prediction count.`));
              const droppedList = element("ul", "rationale-list");
              round.dropped_predictions.forEach((dropped) => droppedList.append(element("li", "", `#${dropped.rank ?? "—"} ${dropped.base_type || "Base"} ${dropped.base_name || dropped.base_id}: ${dropped.reason || "invalid prediction"}.`)));
              warning.append(droppedList); participantBody.append(warning);
            }
            const bets = element("div", "round__bets"); (round.predictions || []).forEach((bet) => bets.append(renderBet(bet))); participantBody.append(bets); participant.append(participantSummary, participantBody); body.append(participant);
          });
          details.append(summaryRow, body); warList.append(details);
          });
          warSection.append(warList); list.append(warSection);
        });
      }

      async function boot() {
        try {
          const base = import.meta.env.BASE_URL.replace(/\/?$/, "/"); const response = await fetch(`${base}data/dashboard.json`, { cache: "no-store" }); if (!response.ok) throw new Error(`HTTP ${response.status}`); dashboard = await response.json();
          const rounds = (dashboard.rounds || []).filter(usableRound); const warSelect = document.querySelector("#round-war"); const modelSelect = document.querySelector("#round-model"); const wars = new Map(); const models = new Map();
          rounds.forEach((round) => { wars.set(String(round.war_id), `War ${round.war_number || "—"}`); models.set(round.series_id, modelLabel(round)); });
          [...wars.entries()].sort((a, b) => b[1].localeCompare(a[1], undefined, { numeric: true })).forEach(([value, label]) => { const option = element("option", "", label); option.value = value; warSelect.append(option); });
          [...models.entries()].sort((a, b) => a[1].localeCompare(b[1])).forEach(([value, label]) => { const option = element("option", "", label); option.value = value; modelSelect.append(option); });
          warSelect.addEventListener("change", () => { warFilter = warSelect.value; renderHistory(); }); modelSelect.addEventListener("change", () => { modelFilter = modelSelect.value; renderHistory(); });
          document.querySelector("#generated-at").textContent = `Generated ${formatDate(dashboard.generated_at)}`; renderHistory();
        } catch (error) { document.querySelector("#round-summary").textContent = `Round history unavailable: ${error.message}`; }
      }
      boot();
    </script>
  </body>
</html>
