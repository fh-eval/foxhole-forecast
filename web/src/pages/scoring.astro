---
import "../styles/global.css";
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Scoring explanations now live beside the adviser scorecard on the dashboard." />
    <title>Scoring Guide · Foxhole Forecast</title>
  </head>
  <body>
    <main class="page-width route-notice">
      <p class="kicker">Scoring guide moved</p>
      <h1>Read the method<br /><span>with the evidence</span></h1>
      <p>The beginner explanation and technical scoring details now appear beside the associated tables on the live dashboard.</p>
      <a class="method-back" href={`${basePath}#method`}>← Open the dashboard method</a>
    </main>
  </body>
</html>
