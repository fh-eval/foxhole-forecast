---
import "../styles/global.css";
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Scoring explanations now live beside the adviser scorecard on the dashboard." />
    <title>Scoring Guide · Foxhole Forecast</title>
  </head>
  <body>
    <main class="page-width route-notice">
      <p class="kicker">This page moved</p>
      <h1>The scoring guide<br /><span>lives with the data now</span></h1>
      <p>The plain-language explanation and the technical details now sit right beside the tables they describe, on the live dashboard.</p>
      <a class="method-back" href={`${basePath}#method`}>← Take me there</a>
    </main>
  </body>
</html>
