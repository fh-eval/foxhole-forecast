---
import "../styles/global.css";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A live, prospective evaluation of LLM forecasts on the Foxhole war." />
    <title>Foxhole Forecast</title>
  </head>
  <body>
    <header class="masthead">
      <div class="masthead__eyebrow">LIVE-1 / ABLE · PROSPECTIVE MODEL EVAL</div>
      <div class="masthead__body page-width">
        <div>
          <h1>Foxhole <span>Forecast</span></h1>
          <p class="lede">Who is the smartest of them all?</p>
          <p class="sublede">Models publish their calls before the front moves. The public War API settles every prediction.</p>
        </div>
        <div class="war-stamp" aria-live="polite">
          <span class="pulse"></span>
          <div><small id="war-status">OBSERVING</small><strong id="war-number">Waiting for data</strong></div>
        </div>
      </div>
    </header>

    <nav class="section-nav" aria-label="Page sections">
      <div class="page-width">
        <a href="#scoreboard">Scoreboard</a>
        <a href="#war-data">War data</a>
        <a href="#rounds">Rounds</a>
        <a href="#briefings">Briefings</a>
        <a href={`${basePath}predictions/`}>Prediction browser</a>
        <a href="#history">History</a>
        <a href="#method">Method</a>
        <a href={`${basePath}scoring/`}>Scoring details</a>
      </div>
    </nav>

    <main class="page-width">
      <section class="status-strip" aria-label="Collection status">
        <div><small>LAST OBSERVATION</small><strong id="last-observation">—</strong></div>
        <div><small>STRATEGIC BASES</small><strong id="base-count">—</strong></div>
        <div><small>COLLECTOR POLLS</small><strong id="poll-count">—</strong></div>
        <div><small>TIMING RESOLUTION</small><strong>≤ 15 min</strong></div>
      </section>

      <section id="scoreboard" class="section-block">
        <div class="section-heading">
          <div><p class="kicker">Performance and behavior</p><h2>How the models think</h2></div>
          <div class="score-heading-controls">
            <p>The forecast score balances short- and long-range CRPS on a 0–100 scale. Raw CRPS minutes, confidence, timing uncertainty, target horizon, and ETA error show how each model tends to make its calls.</p>
            <div class="segmented" role="group" aria-label="Score history scope">
              <button class="active" data-score-scope="current">Current war</button>
              <button data-score-scope="all">All wars</button>
            </div>
          </div>
        </div>
        <div class="table-shell">
          <table class="score-table" aria-describedby="score-guide">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Model</th>
                <th>Forecast score<small>Balanced 0–100 ↑</small></th>
                <th>Short CRPS<small>0–6h bets · mean minutes ↓</small></th>
                <th>Long CRPS<small>6–24h bets · mean minutes ↓</small></th>
                <th>Confidence<small>Mean stated</small></th>
                <th>Timing uncertainty<small>Mean sigma ↓</small></th>
                <th>Typical 0–6h target<small>Median after cutoff</small></th>
                <th>Typical 6–24h target<small>Median after cutoff</small></th>
                <th>ETA error<small>Median matched event ↓</small></th>
                <th>Settlement<small>Scored / censored / open</small></th>
              </tr>
            </thead>
            <tbody id="score-rows" aria-live="polite"></tbody>
          </table>
          <p id="score-empty" class="empty-state" hidden>No model has completed a full round under the current protocol yet.</p>
        </div>
        <dl id="score-guide" class="score-guide">
          <div><dt>Forecast score</dt><dd>Short and long CRPS are normalized against fixed 540- and 1,620-minute protocol windows, weighted 50/50, and converted to 0–100. Higher is better; it is not percent accuracy.</dd></div>
          <div><dt>Short / long CRPS</dt><dd>Mean CRPS is kept separate for ranks 1–4 and 5–8. Lower is better; 0 minutes is perfect.</dd></div>
          <div><dt>Confidence</dt><dd>Probability that the named outcome occurs by ETA + 3 hours.</dd></div>
          <div><dt>Timing uncertainty</dt><dd>Mean standard deviation around the ETA. Historical values are inferred from confidence; new values come from the model.</dd></div>
          <div><dt>Typical targets</dt><dd>Median ETA lead is reported separately inside the required 0–6h and 6–24h tranches, so the imposed timeline does not blur model behavior.</dd></div>
          <div><dt>ETA error</dt><dd>Median distance from the ETA to a matched transition interval; no-event misses are not measurable here.</dd></div>
          <div><dt>Censored</dt><dd>Settled without a score because observation coverage could not support a fair result.</dd></div>
        </dl>
      </section>

      <section id="war-data" class="section-block">
        <div class="section-heading">
          <div><p class="kicker">The scout packet</p><h2>Current war telemetry</h2></div>
          <p>This table is generated from the same all-region scout packet sent to every model: ownership, recent event activity, casualty pace, and new-to-region enlistment activity. Forecast rounds retain their earlier cutoff.</p>
        </div>
        <div id="telemetry-summary" class="telemetry-grid"></div>
        <div class="telemetry-layout">
          <div>
            <div class="subheading"><h3>All regions, ranked by recent activity</h3><span id="telemetry-cutoff">—</span></div>
            <div class="table-shell telemetry-scroll">
              <table class="telemetry-table">
                <thead><tr><th>Region</th><th>Events<small>2h / 6h / 24h</small></th><th>Bases<small>W / C / neutral</small></th><th>Warden casualties<small>1h pace · total · 2h change</small></th><th>Colonial casualties<small>1h pace · total · 2h change</small></th><th>Enlistments<small>1h new-region pace · total · 2h change</small></th><th>Latest event</th></tr></thead>
                <tbody id="telemetry-regions"></tbody>
              </table>
            </div>
          </div>
          <div class="event-feed">
            <div class="subheading"><h3>Latest observed changes</h3><span>Official API only</span></div>
            <ol id="telemetry-events"></ol>
          </div>
        </div>
      </section>

      <section id="rounds" class="section-block">
        <div class="section-heading">
          <div><p class="kicker">Dated sets of bets</p><h2>Prediction rounds</h2></div>
          <p>Each round is one shared three-hour UTC block. Open it to compare every participating model’s cutoff-time briefing and eight ranked predictions.</p>
        </div>
        <div id="round-list" class="round-list"></div>
      </section>

      <section id="briefings" class="section-block">
        <div class="section-heading section-heading--controls">
          <div><p class="kicker">What they think now</p><h2>Latest war briefings</h2></div>
          <label class="select-label">Model <select id="briefing-model"></select></label>
        </div>
        <div id="briefing-list" class="briefing-list"></div>
      </section>

      <section id="history" class="section-block">
        <div class="section-heading section-heading--controls">
          <div><p class="kicker">Track the narrative</p><h2>Model history</h2></div>
          <label class="select-label">Model <select id="history-model"></select></label>
        </div>
        <ol id="history-list" class="history-list"></ol>
      </section>

      <section id="method" class="section-block methodology">
        <div><p class="kicker">How this works</p><h2>A forecast, not a hindsight test</h2></div>
        <div class="method-grid">
          <article><span>01</span><h3>Observe</h3><p>The official Foxhole War API is polled every 15 minutes. A tagged FoxholeStats snapshot backfills pre-launch history only; every prompt remains cutoff-safe.</p></article>
          <article><span>02</span><h3>Forecast</h3><p>Each model scouts six regions, then publishes eight ranked state-transition bets: four with ETAs within six hours and four with ETAs from six to 24 hours.</p></article>
          <article><span>03</span><h3>Settle</h3><p>Interval-aware CRPS evaluates each probability distribution through ETA + 3 hours. Short and long CRPS stay separate, then receive equal weight in the 0–100 forecast score.</p></article>
        </div>
        <a class="method-link" href={`${basePath}scoring/`}>Read the complete scoring method and rationale →</a>
        <p class="fine-print">Foxhole Forecast is an independent, non-commercial experiment. Foxhole is developed by Siege Camp. Model summaries are predictions, not gameplay advice.</p>
      </section>
    </main>

    <footer><div class="page-width"><strong>FOXHOLE FORECAST</strong><span id="generated-at">No dataset generated yet</span></div></footer>

    <script>
      // @ts-nocheck
      const element = (tag, className, text) => {
        const value = document.createElement(tag);
        if (className) value.className = className;
        if (text !== undefined) value.textContent = String(text);
        return value;
      };
      const formatDate = (value) => value ? new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(new Date(value)) + " UTC" : "—";
      const decimal = (value) => value == null || !Number.isFinite(Number(value)) ? "—" : Number(value).toFixed(2);
      const number = (value) => new Intl.NumberFormat().format(Number(value) || 0);
      const eventLabel = (value) => String(value || "").replaceAll("_", " ").toLowerCase().replace(/\b\w/g, (letter) => letter.toUpperCase());
      const trancheLabel = (value) => value === "IMMEDIATE"
        ? "ETA within 6 hours"
        : value === "EXTENDED"
          ? "ETA 6–24 hours"
          : eventLabel(value);
      const teamLabel = (value) => value === "NONE" ? "Neutral / destroyed" : eventLabel(value);
      const regionLabel = (value) => String(value || "Unknown region").replace(/Hex$/, "").replace(/([a-z])([A-Z])/g, "$1 $2");
      const predictionTime = (value) => value ? new Intl.DateTimeFormat(undefined, {
        month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "UTC",
      }).format(new Date(value)) + " UTC" : "an unknown time";
      const evidenceValue = (item) => {
        if (item.value == null) return "value unavailable";
        if (String(item.metric_id).includes("ratio_")) return `${Number(item.value).toFixed(2)}×`;
        const formatted = number(item.value);
        return String(item.metric_id).includes(".delta_") && Number(item.value) > 0 ? `+${formatted}` : formatted;
      };
      const evidenceChip = (item) => {
        const chip = element("span", "evidence-chip", `${item.label || item.metric_id}: ${evidenceValue(item)} · relevance ${item.relevance}/10`);
        if (item.observed_at) chip.title = `Metric observed ${formatDate(item.observed_at)}`;
        return chip;
      };
      let dashboard = null;
      let briefingFilter = "all";
      let scoreScope = "current";
      let protocolRounds = [];
      let visibleSeries = new Set();

      function isCompleteCurrentRound(round) {
        const expected = dashboard?.methodology?.predictions_per_round ?? 8;
        const currentProtocol = dashboard?.methodology?.current_protocol;
        const predictions = round.predictions || [];
        return round.protocol === currentProtocol
          && predictions.length >= 1
          && predictions.length <= expected
          && predictions.every((bet) =>
            ["CAPTURED", "CAPTURED_BY_WARDENS", "CAPTURED_BY_COLONIALS", "DESTROYED", "SELF_CAPTURE"].includes(bet.predicted_outcome)
            && bet.base_name
            && bet.base_type
            && bet.current_team
            && bet.confidence != null
            && bet.sigma_minutes != null
            && bet.eta_utc
            && Array.isArray(bet.evidence)
            && bet.evidence.length > 0
          );
      }

      const mean = (values) => values.length ? values.reduce((total, value) => total + value, 0) / values.length : null;
      const median = (values) => {
        if (!values.length) return null;
        const ordered = [...values].sort((a, b) => a - b);
        const middle = Math.floor(ordered.length / 2);
        return ordered.length % 2 ? ordered[middle] : (ordered[middle - 1] + ordered[middle]) / 2;
      };
      const duration = (minutes) => {
        if (minutes == null) return "—";
        return minutes < 60 ? `${Math.round(minutes)}m` : `${(minutes / 60).toFixed(1)}h`;
      };
      const crps = (minutes) => minutes == null || !Number.isFinite(Number(minutes)) ? "—" : `${Number(minutes).toFixed(2)}m`;

      function modelBehavior(model, rounds) {
        const bets = rounds.filter((round) => round.series_id === model.series_id).flatMap((round) => round.predictions || []);
        const scoreable = bets.filter((bet) => predictionScoreValue(bet) != null);
        const confidences = bets.map((bet) => Number(bet.confidence)).filter(Number.isFinite);
        const sigmas = bets.map((bet) => Number(bet.sigma_minutes)).filter(Number.isFinite);
        const leadMinutes = (tranche) => bets
          .filter((bet) => bet.tranche === tranche)
          .map((bet) => (new Date(bet.eta_utc) - new Date(bet.cutoff || rounds.find((round) => round.run_id === bet.run_id)?.cutoff)) / 60000)
          .filter((value) => Number.isFinite(value) && value >= 0);
        const etaErrors = scoreable.filter((bet) => bet.eta_error_minutes != null).map((bet) => Number(bet.eta_error_minutes)).filter(Number.isFinite);
        const trancheCrps = (tranche) => scoreable
          .filter((bet) => bet.tranche === tranche)
          .map((bet) => Number(bet.crps_minutes))
          .filter(Number.isFinite);
        const shortCrpsValues = trancheCrps("IMMEDIATE");
        const longCrpsValues = trancheCrps("EXTENDED");
        const shortCrpsMinutes = mean(shortCrpsValues);
        const longCrpsMinutes = mean(longCrpsValues);
        const scoreConfig = dashboard?.methodology?.forecast_score || {};
        const forecastScore = shortCrpsMinutes == null || longCrpsMinutes == null
          ? null
          : Math.max(0, Math.min(100, 100 * (1
            - (scoreConfig.short_weight ?? 0.5) * shortCrpsMinutes / (scoreConfig.short_crps_scale_minutes ?? 540)
            - (scoreConfig.long_weight ?? 0.5) * longCrpsMinutes / (scoreConfig.long_crps_scale_minutes ?? 1620))));
        const count = (status) => bets.filter((bet) => bet.status === status).length;
        return {
          model,
          bets,
          scoreable,
          publishedCount: bets.length,
          scoreableCount: scoreable.length,
          forecastScore,
          shortCrpsMinutes,
          longCrpsMinutes,
          shortScoreableCount: shortCrpsValues.length,
          longScoreableCount: longCrpsValues.length,
          confidence: mean(confidences),
          sigmaMinutes: mean(sigmas),
          immediateLeadMinutes: median(leadMinutes("IMMEDIATE")),
          extendedLeadMinutes: median(leadMinutes("EXTENDED")),
          etaErrorMinutes: median(etaErrors),
          matched: etaErrors.length,
          hits: count("hit"),
          partials: count("partial"),
          misses: count("miss"),
          censored: count("censored"),
          open: count("open"),
        };
      }

      function metricCell(value, note, className = "") {
        const cell = element("td", `score-table__metric ${className}`.trim());
        cell.append(element("strong", "", value), element("small", "", note));
        return cell;
      }

      function renderScores(models, rounds, summaries = []) {
        const rows = document.querySelector("#score-rows");
        const empty = document.querySelector("#score-empty");
        rows.replaceChildren();
        empty.hidden = models.length > 0;
        if (!models.length) {
          return;
        }
        const summaryLookup = new Map(summaries.map((summary) => [summary.series_id, summary]));
        const behaviors = models.map((model) => {
          const summary = summaryLookup.get(model.series_id);
          return summary ? {
            model,
            publishedCount: summary.published_bets,
            scoreableCount: summary.scoreable_bets,
            forecastScore: summary.forecast_score,
            shortCrpsMinutes: summary.short_crps_minutes,
            longCrpsMinutes: summary.long_crps_minutes,
            shortScoreableCount: summary.short_scoreable_bets,
            longScoreableCount: summary.long_scoreable_bets,
            confidence: summary.confidence,
            sigmaMinutes: summary.sigma_minutes,
            immediateLeadMinutes: summary.immediate_lead_minutes,
            extendedLeadMinutes: summary.extended_lead_minutes,
            etaErrorMinutes: summary.eta_error_minutes,
            matched: summary.matched_transitions,
            hits: summary.hits,
            partials: summary.partials,
            misses: summary.misses,
            censored: summary.censored,
            open: summary.open,
          } : modelBehavior(model, rounds);
        }).sort((a, b) =>
          (a.forecastScore == null) - (b.forecastScore == null)
          || (b.forecastScore ?? -Infinity) - (a.forecastScore ?? -Infinity)
          || (a.shortCrpsMinutes ?? Infinity) - (b.shortCrpsMinutes ?? Infinity)
          || (a.longCrpsMinutes ?? Infinity) - (b.longCrpsMinutes ?? Infinity)
          || String(a.model.label).localeCompare(String(b.model.label))
        );
        behaviors.forEach((behavior, index) => {
          const row = document.createElement("tr");
          const modelCell = element("td", "score-table__model");
          modelCell.append(
            element("strong", "", behavior.model.label || behavior.model.series_id),
            element("small", "", `${behavior.model.gateway || "provider"} · ${behavior.model.returned_model || behavior.model.requested_model || behavior.model.series_id}`),
          );
          const resultsCell = element("td", "score-table__results");
          resultsCell.append(
            element("strong", "", `${behavior.scoreableCount} / ${behavior.censored} / ${behavior.open}`),
            element("small", "", "scored / censored / open"),
          );
          row.append(
            element("td", "score-table__rank", String(index + 1).padStart(2, "0")),
            modelCell,
            metricCell(decimal(behavior.forecastScore), behavior.forecastScore == null ? "waiting for both timelines" : "equal short / long weight", "score-table__primary"),
            metricCell(crps(behavior.shortCrpsMinutes), `${behavior.shortScoreableCount} scored short bets`),
            metricCell(crps(behavior.longCrpsMinutes), `${behavior.longScoreableCount} scored long bets`),
            metricCell(decimal(behavior.confidence), `${behavior.publishedCount} published bets`),
            metricCell(duration(behavior.sigmaMinutes), "conditional standard deviation"),
            metricCell(duration(behavior.immediateLeadMinutes), "within required tranche"),
            metricCell(duration(behavior.extendedLeadMinutes), "within required tranche"),
            metricCell(duration(behavior.etaErrorMinutes), `${behavior.matched} matched transitions`),
            resultsCell,
          );
          rows.append(row);
        });
      }

      function renderScoreboard() {
        const scopedRounds = scoreScope === "current"
          ? protocolRounds.filter((round) => round.war_id === dashboard?.war?.warId)
          : protocolRounds;
        const summaries = scoreScope === "current"
          ? dashboard?.model_behavior?.current_war || []
          : dashboard?.model_behavior?.all_time || [];
        const scopedSeries = new Set(
          summaries.length
            ? summaries.map((summary) => summary.series_id)
            : scopedRounds.map((round) => round.series_id)
        );
        const scopedModels = (dashboard?.models || []).filter((model) => scopedSeries.has(model.series_id));
        renderScores(scopedModels, scopedRounds, summaries);
      }

      function renderWarData(snapshot) {
        const summary = document.querySelector("#telemetry-summary");
        const regions = document.querySelector("#telemetry-regions");
        const events = document.querySelector("#telemetry-events");
        summary.replaceChildren();
        regions.replaceChildren();
        events.replaceChildren();
        if (!snapshot) {
          summary.append(element("p", "empty-state", "No official War API snapshot is available yet."));
          return;
        }
        const ownership = snapshot.strategic_base_ownership || {};
        const casualties = snapshot.casualties || {};
        [
          ["Day of war", snapshot.day_of_war ?? "—"],
          ["Warden strategic bases", number(ownership.WARDENS)],
          ["Colonial strategic bases", number(ownership.COLONIALS)],
          ["Warden casualties", number(casualties.WARDENS)],
          ["Colonial casualties", number(casualties.COLONIALS)],
        ].forEach(([label, value]) => {
          const card = element("article", "telemetry-card");
          card.append(element("small", "", label), element("strong", "", value));
          summary.append(card);
        });
        document.querySelector("#telemetry-cutoff").textContent = `Packet v${snapshot.packet_version || "—"} · ${snapshot.history_hours_available ?? 0}h history · ${formatDate(snapshot.observed_at)}`;
        (snapshot.active_regions || []).forEach((region) => {
          const activity = region.activity || {};
          const ownership = region.ownership || {};
          const row = document.createElement("tr");
          row.append(
            element("td", "", regionLabel(region.map_name)),
            telemetryPair(
              `${number(activity.events_2h)} / ${number(activity.events_6h)} / ${number(activity.events_24h)}`,
              "ownership transitions",
              activity.events_2h ? "activity" : "",
            ),
            telemetryPair(
              `${number(ownership.WARDENS)} / ${number(ownership.COLONIALS)} / ${number(ownership.NONE)}`,
              `${number(region.strategic_base_count)} strategic bases`,
            ),
            telemetryTrend(region, "warden_casualties"),
            telemetryTrend(region, "colonial_casualties"),
            telemetryTrend(region, "enlistments"),
            telemetryPair(activity.latest_event_at ? predictionTime(activity.latest_event_at) : "—", "most recent transition"),
          );
          regions.append(row);
        });
        const recent = snapshot.recent_ownership_events || [];
        if (!recent.length) {
          events.append(element("li", "empty-state", "No official ownership changes have been observed in the last 24 hours."));
        } else {
          recent.forEach((event) => {
            const item = element("li", "event-feed__item");
            item.append(
              element("time", "", formatDate(event.observed_at)),
              element("strong", "", `${event.base_name || "Unknown base"} · ${event.map_display_name || regionLabel(event.map_name)}`),
              element("span", "", `${eventLabel(event.event_type)} · ${eventLabel(event.actor)}`),
            );
            events.append(item);
          });
        }
      }

      function signed(value) {
        if (value == null || !Number.isFinite(Number(value))) return "—";
        return `${Number(value) > 0 ? "+" : ""}${number(value)}`;
      }

      function telemetryPair(primary, secondary, className = "") {
        const cell = element("td", `telemetry-pair ${className}`.trim());
        cell.append(element("strong", "", primary), element("small", "", secondary));
        return cell;
      }

      function telemetryTrend(region, field) {
        const trend = region.rate_trends?.["1h_vs_prior_1h"]?.[field];
        const reportField = field === "enlistments" ? "total_enlistments" : field;
        const raw = region.report?.[reportField];
        const delta = region.report_deltas?.["2h"]?.[reportField];
        const direction = trend?.[3];
        const symbol = direction === "accelerating" ? "↑" : direction === "cooling" ? "↓" : direction === "steady" ? "→" : "";
        const rate = trend ? `${number(trend[0])}/h ${symbol}`.trim() : "—";
        const cell = telemetryPair(rate, `${number(raw)} total · ${signed(delta)} / 2h`, direction ? `trend trend--${direction}` : "");
        if (trend) cell.title = `Previous 1h pace: ${number(trend[1])}/h; change: ${signed(trend[2])}/h; ${direction}`;
        return cell;
      }

      function stat(label, value) {
        const wrapper = element("div", "");
        wrapper.append(element("small", "", label), element("strong", "", value));
        return wrapper;
      }

      function renderBriefings(models) {
        const list = document.querySelector("#briefing-list");
        list.replaceChildren();
        const available = models.filter((model) => model.latest?.war_summary && (briefingFilter === "all" || model.series_id === briefingFilter));
        if (!available.length) {
          list.append(element("p", "empty-state", "The first model briefing will appear after a valid forecast cohort."));
          return;
        }
        available.forEach((model) => {
          const article = element("article", "briefing");
          const header = element("div", "briefing__header");
          header.append(element("h3", "", model.label), element("time", "", formatDate(model.latest.cutoff)));
          const regions = element("p", "region-list", model.latest.selected_regions?.join(" · ") || "No selected regions");
          article.append(header, element("p", "briefing__copy", model.latest.war_summary), regions);
          list.append(article);
        });
      }

      function setupBriefingFilter(models) {
        const select = document.querySelector("#briefing-model");
        select.replaceChildren();
        const all = element("option", "", "All models");
        all.value = "all";
        select.append(all);
        models.filter((model) => model.latest?.war_summary).forEach((model) => {
          const option = element("option", "", model.label || model.series_id);
          option.value = model.series_id;
          select.append(option);
        });
        select.addEventListener("change", () => {
          briefingFilter = select.value;
          renderBriefings((dashboard.models || []).filter((model) => visibleSeries.has(model.series_id)));
        });
      }

      function factionName(team) {
        return element("span", `faction-name faction-name--${String(team || "none").toLowerCase()}`, teamLabel(team));
      }

      function baseIdentity(bet) {
        return element(
          "strong",
          `base-identity base-identity--${String(bet.current_team || "none").toLowerCase()}`,
          `${bet.base_type || "Strategic Base"} ${bet.base_name || "Unknown base"}`,
        );
      }

      function predictionHeadline(bet) {
        const line = element("p", "prediction-headline");
        const predictedOutcome = bet.predicted_outcome || (typeof bet.outcome === "string" ? bet.outcome : null);
        const sigmaSource = bet.sigma_source === "inferred_from_confidence" ? " (inferred)" : "";
        const sigma = bet.sigma_minutes == null ? "" : ` · σ ${duration(Number(bet.sigma_minutes))}${sigmaSource}`;
        const confidence = element("strong", "prediction-headline__confidence", `${decimal(bet.confidence)} confidence${sigma}`);
        line.append(confidence, document.createTextNode(": "));
        if (predictedOutcome) {
          line.append(baseIdentity(bet));
          if (predictedOutcome === "DESTROYED") {
            line.append(document.createTextNode(" will be destroyed at "));
          } else if (predictedOutcome === "SELF_CAPTURE") {
            line.append(document.createTextNode(" will be destroyed (predicted faction would capture its own base) at "));
          } else {
            line.append(document.createTextNode(" will be captured by "));
            const predictedFaction = predictedOutcome === "CAPTURED_BY_WARDENS"
              ? "WARDENS"
              : predictedOutcome === "CAPTURED_BY_COLONIALS"
                ? "COLONIALS"
                : null;
            if (predictedFaction) {
              line.append(factionName(predictedFaction));
            } else if (bet.current_team === "WARDENS") {
              line.append(factionName("COLONIALS"));
            } else if (bet.current_team === "COLONIALS") {
              line.append(factionName("WARDENS"));
            } else {
              line.append(factionName("WARDENS"), document.createTextNode(" or "), factionName("COLONIALS"));
            }
            line.append(document.createTextNode(" at "));
          }
          line.append(element("time", "prediction-headline__time", predictionTime(bet.eta_utc)), document.createTextNode("."));
          return line;
        }

        // Retain a readable sentence for archived destination/event protocols.
        if (bet.destination_team) {
          line.append(baseIdentity(bet));
          line.append(document.createTextNode(" will be captured by "), factionName(bet.destination_team), document.createTextNode(" at "));
        } else if (String(bet.event_type).startsWith("CAPTURED_BY_") && bet.actor) {
          line.append(baseIdentity(bet));
          line.append(document.createTextNode(" will be captured by "), factionName(bet.actor), document.createTextNode(" at "));
        } else if (bet.event_type === "OWNER_LOSES" && bet.actor) {
          line.append(baseIdentity({ ...bet, current_team: bet.actor }));
          line.append(document.createTextNode(" will lose ownership at "));
        } else {
          line.append(baseIdentity(bet));
          line.append(document.createTextNode(` will undergo ${eventLabel(bet.event_type)} at `));
        }
        line.append(element("time", "prediction-headline__time", predictionTime(bet.eta_utc)), document.createTextNode("."));
        return line;
      }

      function supportingEvidence(items) {
        const wrapper = element("div", "supporting-evidence");
        wrapper.append(element("small", "supporting-evidence__label", "Supporting evidence"));
        const evidence = element("div", "evidence-list");
        (items || []).forEach((item) => evidence.append(evidenceChip(item)));
        if (!items?.length) evidence.append(element("span", "evidence-empty", "No supporting evidence retained."));
        wrapper.append(evidence);
        return wrapper;
      }

      function predictionStatus(bet) {
        if (bet.status === "censored" && bet.settlement_reason === "ambiguous_transition_interval") {
          return "Not scored · transition time ambiguous";
        }
        if (bet.status === "censored") return "Not scored · missing observations";
        if (bet.crps_minutes != null && bet.settlement_reason === "no_transition_by_deadline") {
          return "Scored · no qualifying transition by deadline";
        }
        if (bet.crps_minutes != null && bet.settlement_reason === "observed_transition") {
          const observation = Number(bet.state_credit) === 1
            ? "named outcome observed"
            : Number(bet.state_credit) > 0
              ? "related outcome observed"
              : "different outcome observed";
          const timing = bet.eta_error_minutes != null ? ` · ${bet.eta_error_minutes}m from ETA` : "";
          return `Scored · ${observation}${timing}`;
        }
        if (bet.crps_minutes != null) return "Scored";
        return eventLabel(bet.status);
      }

      function predictionScoreValue(bet) {
        if (bet.crps_minutes == null) return null;
        const value = Number(bet.crps_minutes);
        return Number.isFinite(value) ? value : null;
      }

      function predictionResult(bet) {
        const result = element("div", "prediction-result");
        const score = predictionScoreValue(bet);
        const displayStatus = score == null ? bet.status : "scored";
        result.append(element("small", `status status--${displayStatus}`, predictionStatus(bet)));
        if (score != null) {
          const badge = element("span", "prediction-score prediction-score--scored");
          badge.append(
            element("span", "prediction-score__label", "CRPS"),
            element("strong", "", crps(score)),
          );
          result.append(badge);
        }
        return result;
      }

      function roundResolutionLabel(round) {
        const expected = dashboard?.methodology?.predictions_per_round ?? 8;
        const resolved = (round.predictions || []).filter((bet) => bet.status && bet.status !== "open").length;
        return `${resolved}/${expected} Predictions Resolved`;
      }

      function groupedRounds(rounds) {
        const groups = new Map();
        rounds.forEach((round) => {
          const slot = round.round_slot || round.cutoff;
          const key = round.round_id || `${round.war_id || "war"}:${slot}`;
          if (!groups.has(key)) {
            groups.set(key, {
              key,
              slot,
              end: round.round_end,
              warNumber: round.war_number,
              participants: [],
            });
          }
          groups.get(key).participants.push(round);
        });
        return [...groups.values()]
          .map((group) => ({
            ...group,
            participants: group.participants.sort((a, b) => String(a.model_label).localeCompare(String(b.model_label))),
          }))
          .sort((a, b) => new Date(b.slot) - new Date(a.slot));
      }

      function roundWindow(group) {
        const start = new Date(group.slot);
        const end = group.end ? new Date(group.end) : new Date(start.getTime() + 3 * 60 * 60 * 1000);
        const day = new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric", timeZone: "UTC" }).format(start);
        const time = (value) => new Intl.DateTimeFormat(undefined, { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "UTC" }).format(value);
        return `${day} · ${time(start)}–${time(end)} UTC`;
      }

      function groupResolutionLabel(group) {
        const expected = (dashboard?.methodology?.predictions_per_round ?? 8) * group.participants.length;
        const resolved = group.participants.flatMap((round) => round.predictions || []).filter((bet) => bet.status && bet.status !== "open").length;
        return `${resolved}/${expected} Predictions Resolved`;
      }

      function renderRounds(rounds) {
        const list = document.querySelector("#round-list");
        list.replaceChildren();
        if (!rounds.length) {
          list.append(element("p", "empty-state", "The first valid timed prediction round has not landed yet."));
          return;
        }
        groupedRounds(rounds).forEach((group, index) => {
          const details = element("details", "round");
          if (index === 0) details.open = true;
          const summary = element("summary", "round__summary");
          summary.append(
            element("strong", "", `${group.warNumber ? `War ${group.warNumber} · ` : ""}${roundWindow(group)}`),
            element("time", "", `${group.participants.length} participating model${group.participants.length === 1 ? "" : "s"}`),
            element("span", `status status--${group.participants.some((round) => round.settlement_status === "open") ? "open" : "complete"}`, groupResolutionLabel(group)),
          );
          const body = element("div", "round__body");
          group.participants.forEach((round) => {
            const participant = element("details", "round-model");
            const participantSummary = element("summary", "round-model__summary");
            participantSummary.append(
              element("strong", "", round.model_label),
              element("time", "", `Data cutoff ${formatDate(round.cutoff)}`),
              element("span", `status status--${round.settlement_status}`, roundResolutionLabel(round)),
            );
            const participantBody = element("div", "round-model__body");
            participantBody.append(
              element("p", "briefing__copy", round.war_summary || "No briefing was retained for this round."),
              element("p", "region-list", (round.selected_regions || []).join(" · ")),
            );
            if (round.dropped_predictions?.length) {
              const warning = element("div", "method-note");
              warning.append(element(
                "strong",
                "",
                `Model error: ${round.dropped_predictions.length} invalid bet${round.dropped_predictions.length === 1 ? " was" : "s were"} dropped and will not be scored.`,
              ));
              const droppedList = element("ul", "rationale-list");
              round.dropped_predictions.forEach((dropped) => {
                const target = String(dropped.outcome || "").replace("CAPTURED_BY_", "");
                droppedList.append(element(
                  "li",
                  "",
                  `#${dropped.rank ?? "—"} ${dropped.base_type || "Base"} ${dropped.base_name || dropped.base_id}: predicted capture by ${teamLabel(target)}, but ${teamLabel(dropped.current_owner)} already owned it.`,
                ));
              });
              warning.append(droppedList);
              participantBody.append(warning);
            }
            const bets = element("div", "round__bets");
            (round.predictions || []).forEach((bet) => {
              const row = element("article", "round-bet");
              const meta = element("div", "round-bet__meta");
              meta.append(
                element("span", "", `#${bet.rank ?? "—"} · ${trancheLabel(bet.tranche)} · ${regionLabel(bet.map_name)}`),
                predictionResult(bet),
              );
              row.append(meta, predictionHeadline(bet), supportingEvidence(bet.evidence));
              bets.append(row);
            });
            participantBody.append(bets);
            participant.append(participantSummary, participantBody);
            body.append(participant);
          });
          details.append(summary, body);
          list.append(details);
        });
      }

      function setupHistory(models) {
        const select = document.querySelector("#history-model");
        select.replaceChildren();
        models.forEach((model) => {
          const option = element("option", "", model.label || model.series_id);
          option.value = model.series_id;
          select.append(option);
        });
        select.addEventListener("change", renderHistory);
        renderHistory();
      }

      function renderHistory() {
        const select = document.querySelector("#history-model");
        const list = document.querySelector("#history-list");
        list.replaceChildren();
        const currentModels = (dashboard.models || []).filter((item) => visibleSeries.has(item.series_id));
        const model = currentModels.find((item) => item.series_id === select.value) || currentModels[0];
        if (!model?.history?.length) {
          list.append(element("li", "empty-state", "No history for this model yet."));
          return;
        }
        model.history.forEach((entry) => {
          const item = element("li", "history-item");
          const marker = element("span", `history-marker history-marker--${entry.settlement_status}`);
          const body = element("div", "");
          const top = element("div", "history-item__top");
          top.append(
            element("time", "", `${entry.war_number ? `War ${entry.war_number} · ` : ""}${formatDate(entry.cutoff)}`),
            element("strong", "", `${entry.forecast_count} bases · ${entry.settlement_status}`),
          );
          body.append(top, element("p", "", entry.war_summary || `Run ${entry.status}; no summary available.`));
          item.append(marker, body);
          list.append(item);
        });
      }

      async function boot() {
        try {
          const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
          const response = await fetch(`${base}data/dashboard.json`, { cache: "no-store" });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          dashboard = await response.json();
          const currentRounds = (dashboard.rounds || []).filter(isCompleteCurrentRound);
          protocolRounds = currentRounds;
          visibleSeries = new Set(currentRounds.map((round) => round.series_id));
          const currentModels = (dashboard.models || []).filter((model) => visibleSeries.has(model.series_id));
          document.querySelector("#war-number").textContent = dashboard.war ? `World Conquest ${dashboard.war.warNumber}` : "Waiting for data";
          document.querySelector("#war-status").textContent = dashboard.forecast_status === "war_inactive"
            ? "WAR ENDED"
            : dashboard.forecast_status === "warming_up"
              ? "WARMING UP"
              : "OBSERVING";
          document.querySelector("#last-observation").textContent = formatDate(dashboard.last_collected_at);
          document.querySelector("#base-count").textContent = dashboard.strategic_base_count ?? 0;
          document.querySelector("#poll-count").textContent = dashboard.collector_runs ?? 0;
          document.querySelector("#generated-at").textContent = dashboard.generated_at ? `Generated ${formatDate(dashboard.generated_at)}` : "No dataset generated yet";
          renderWarData(dashboard.war_api_snapshot);
          renderScoreboard();
          renderRounds(currentRounds);
          setupBriefingFilter(currentModels);
          renderBriefings(currentModels);
          setupHistory(currentModels);
        } catch (error) {
          const empty = document.querySelector("#score-empty");
          empty.textContent = `Dashboard data could not be loaded: ${error.message}`;
          empty.hidden = false;
        }
      }

      document.querySelectorAll("[data-score-scope]").forEach((button) => button.addEventListener("click", () => {
        scoreScope = button.dataset.scoreScope;
        document.querySelectorAll("[data-score-scope]").forEach((item) => item.classList.toggle("active", item === button));
        if (dashboard) renderScoreboard();
      }));

      boot();
    </script>
  </body>
</html>
