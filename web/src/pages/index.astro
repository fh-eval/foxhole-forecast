---
import "../styles/global.css";
import Briefings from "../components/Briefings.astro";
import DashboardNav from "../components/DashboardNav.astro";
import EvidenceCaution from "../components/EvidenceCaution.astro";
import Footer from "../components/Footer.astro";
import HumanNote from "../components/HumanNote.astro";
import InvestigationIntro from "../components/InvestigationIntro.astro";
import Limitations from "../components/Limitations.astro";
import Masthead from "../components/Masthead.astro";
import Method from "../components/Method.astro";
import Probability from "../components/Probability.astro";
import RetentionDetail from "../components/RetentionDetail.astro";
import Rounds from "../components/Rounds.astro";
import Scoreboard from "../components/Scoreboard.astro";
import StatusStrip from "../components/StatusStrip.astro";
import WarData from "../components/WarData.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3eedd" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#191d19" />
    <meta name="description" content="A live, prospective evaluation of LLM forecasts on the Foxhole war." />
    <title>Foxhole Forecast</title>
  </head>
  <body id="top">
    <HumanNote basePath={basePath} />
    <Masthead />
    <DashboardNav basePath={basePath} />

    <main class="page-width dashboard-page">
      <StatusStrip />

      <InvestigationIntro />

      <Scoreboard basePath={basePath} />

      <EvidenceCaution />

      <Probability />

      <RetentionDetail />

      <WarData />

      <Rounds basePath={basePath} />

      <Briefings />

      <Limitations />

      <Method basePath={basePath} />
    </main>

    <Footer />

    <script src="../scripts/dashboard.ts"></script>
  </body>
</html>
